            DADR = Arg0
            Return (VIC0) /* \_SB_.PC00.VIIC.VIC0 */
        }

        Method (INTB, 3, Serialized)
        {
            Name (INTR, ResourceTemplate ()
            {
                Interrupt (ResourceConsumer, Level, ActiveLow, ExclusiveAndWake, ,, _Y17)
                {
                    0x00000000,
                }
            })
