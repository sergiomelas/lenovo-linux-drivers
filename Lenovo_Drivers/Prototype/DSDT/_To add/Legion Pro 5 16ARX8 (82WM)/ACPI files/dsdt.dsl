            {
                If ((TPTY == One))
                {
                    _HID = "ELAN06FA"
                    _SUB = "ELAN0001"
                    Return (Zero)
                }

                If ((TPTY == 0x02))
                {
                    _HID = "SYNA2BA6"
                    _SUB = "SYNA0001"
                    Return (Zero)
                }

                If ((TPTY == 0x04))
                {
                    _HID = "GXTP5100"
                    _SUB = "GOOD0001"
