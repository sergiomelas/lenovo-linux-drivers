        }

        Method (RECM, 1, Serialized)
        {
            ACMX = Arg0
            Return (ACMA) /* \_SB_.ACMA */
        }

        Method (WTCM, 2, Serialized)
        {
            If ((Arg0 == 0xA55A))
            {
                If (Ones)
                {
                    Local0 = RECM (0x50)
                    Local1 = RECM (0x51)
                    Local2 = RECM (Local0)
                    If ((((Local0 + Local2) + One) > Local1))
                    {
                        Local2 = One
                    }
                    Else
                    {
                        Local2 += One
                    }

                    ACMX = Local0
                    ACMA = Local2
                    ACMX = (Local0 + Local2)
                    ACMA = Arg1
                }
            }
            Else
            {
                ACMX = Arg0
                ACMA = Arg1
            }
        }

        Method (LP80, 1, Serialized)
        {
            Local0 = (Arg0 >> 0x08)
            Local1 = (Arg0 & 0xFF)
            If ((Local0 != Zero))
            {
                LO80 = Arg0
                If (Ones)
                {
                    WTCM (0xA55A, Local0)
                }

                WTCM (0xA55A, Local1)
            }
            Else
            {
                LO80 = Arg0
                WTCM (0xA55A, Local1)
            }
        }

