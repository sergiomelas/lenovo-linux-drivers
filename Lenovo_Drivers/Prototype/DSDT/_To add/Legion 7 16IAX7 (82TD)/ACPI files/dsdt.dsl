                    Local0 = ^^PC00.LPCB.EC0.LSTE /* \_SB_.PC00.LPCB.EC0_.LSTE */
                    LIDS = Local0
                    ^^PC00.LPCB.EC0.RELK ()
                    ^^PC00.GFX0.GLID (LIDS)
                    If ((Local0 & One))
