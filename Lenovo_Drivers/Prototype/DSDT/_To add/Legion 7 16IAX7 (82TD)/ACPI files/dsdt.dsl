    Scope (_SB)
    {
        OperationRegion (ACMS, SystemIO, 0x72, 0x02)
        Field (ACMS, ByteAcc, NoLock, Preserve)
        {
            ACMX,   8, 
            ACMA,   8
        }

        OperationRegion (LDBG, SystemIO, 0x80, 0x02)
        Field (LDBG, WordAcc, NoLock, Preserve)
        {
