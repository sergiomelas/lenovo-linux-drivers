    Scope (_SB.PC00.RP01)
    {
        Method (_PRW, 0, NotSerialized)  // _PRW: Power Resources for Wake
        {
            If (((PSW3 != Zero) && (RPN3 == One)))
            {
                Return (GPRW (GGPE (PSW3), 0x04))
            }
            ElseIf (((PSW2 != Zero) && (RPN2 == One)))
            {
                Return (GPRW (GGPE (PSW2), 0x04))
            }
            Else
            {
                Return (GPRW (0x69, 0x04))
            }
        }
    }

