    Method (_WAK, 1, Serialized)  // _WAK: Wake
    {
        D8XH (One, 0xAB)
        \_SB.GZFD.TBTP = Zero
        If ((Arg0 == One))
        {
            \_SB.LP80 (0xE1)
        }

        If ((Arg0 == 0x03))
        {
            \_SB.LP80 (0xE3)
            SXSF = One
        }

        If ((Arg0 == 0x04))
        {
            \_SB.LP80 (0xE4)
        }

        If ((Arg0 == 0x05))
        {
            \_SB.LP80 (0xE5)
        }

        \_SB.PC00.LPCB.EC0.HIND = 0x57
        Local0 = \_SB.PC00.LPCB.EC0.HDAT
        If ((((Local0 == 0x52) || (Local0 == 0xFF)) && (\_SB.PC00.LPCB.EC0.PWPD <= 
            0xC8)))
        {
            ODV1 = Zero
            \_SB.PC00.LPCB.EC0.ITSC = 0xBB
            \_SB.PC00.LPCB.EC0.HIND = 0x57
            \_SB.PC00.LPCB.EC0.HDAT = 0x5F
        }

        ADBG ("_WAK")
        Name (RPWM, Zero)
        If ((DSTS == Zero))
        {
            RPWM = Zero
        }
        Else
        {
            RPWM = 0x0180
        }

        \_TZ.TZ00.S4FL = Zero
        SWAK (Arg0, RPWM)
        If ((Arg0 == 0x03))
        {
            If ((Zero == ACTT)){}
        }

        If (((Arg0 == 0x03) || (Arg0 == 0x04)))
        {
            If ((GBSX & 0x40))
            {
                \_SB.PC00.GFX0.IUEH (0x06)
                PB1E ^= 0x08
            }

            If ((GBSX & 0x80))
            {
                \_SB.PC00.GFX0.IUEH (0x07)
                PB1E ^= 0x10
            }

            If ((HGMD == 0x03))
            {
                \_SB.SGOV (0x080B0017, One)
            }
            Else
            {
                \_SB.SGOV (0x080B0017, Zero)
            }

            If ((ECON == One))
            {
                If (((Arg0 == 0x03) || (Arg0 == 0x04)))
                {
                    LIDS = \_SB.PC00.LPCB.EC0.ECRD (RefOf (\_SB.PC00.LPCB.EC0.LSTE))
                    If (IGDS)
