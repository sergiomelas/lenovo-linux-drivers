            {
                Local0 = One
                If ((^^PC00.LPCB.EC0.GETK () == One))
                {
                    Local0 = ^^PC00.LPCB.EC0.RPWR /* \_SB_.PC00.LPCB.EC0_.RPWR */
                    PWRS = Local0
                    ^^PC00.LPCB.EC0.RELK ()
                    CreateWordField (XX00, Zero, SSZE)
                    CreateByteField (XX00, 0x02, ACST)
                    SSZE = 0x03
                    If ((Local0 != ACDC))
