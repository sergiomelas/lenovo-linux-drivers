        Device (HKDV)
        {
            Name (_HID, "LHK2019")  // _HID: Hardware ID
            Name (_UID, Zero)  // _UID: Unique ID
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }
        }

        Device (WMIU)
        {
            Name (_HID, "PNP0C14" /* Windows Management Instrumentation Device */)  // _HID: Hardware ID
            Name (_UID, "LSK20")  // _UID: Unique ID
            Name (_WDG, Buffer (0x3C)
            {
                /* 0000 */  0x74, 0x09, 0x6C, 0xCE, 0x07, 0x04, 0x50, 0x4F,  // t.l...PO
                /* 0008 */  0x88, 0xBA, 0x4F, 0xC3, 0xB6, 0x55, 0x9A, 0xD8,  // ..O..U..
                /* 0010 */  0x53, 0x4B, 0x01, 0x02, 0x0C, 0xDE, 0xC0, 0x8F,  // SK......
                /* 0018 */  0xE4, 0xB4, 0xFD, 0x43, 0xB0, 0xF3, 0x88, 0x71,  // ...C...q
                /* 0020 */  0x71, 0x1C, 0x12, 0x94, 0xD0, 0x00, 0x01, 0x08,  // q.......
                /* 0028 */  0x21, 0x12, 0x90, 0x05, 0x66, 0xD5, 0xD1, 0x11,  // !...f...
                /* 0030 */  0xB2, 0xF0, 0x00, 0xA0, 0xC9, 0x06, 0x29, 0x10,  // ......).
                /* 0038 */  0x44, 0x41, 0x01, 0x00                           // DA..
            })
            Method (WMSK, 3, Serialized)
            {
                If ((Arg1 == One))
                {
                    If ((ToInteger (Arg2) == One))
                    {
                        Return (0x03)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x03))
                    {
                        Return (0x02)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x07))
                    {
                        Return (0x02)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x08))
                    {
                        Return (0x02)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x0E))
                    {
                        Return (0x15)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x0F))
                    {
                        Switch (ToInteger (LTKB))
                        {
                            Case (0x02)
                            {
                                Return (0x15)
                            }
                            Case (0x03)
                            {
                                Return (0x15)
                            }
                            Default
                            {
                                Return (Zero)
                            }

                        }
                    }
                    ElseIf ((ToInteger (Arg2) == 0x13))
                    {
                        Return (Zero)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x14))
                    {
                        Return (0x19)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x15))
                    {
                        Return (0x1A)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x17))
                    {
                        If ((LTCC == Zero))
                        {
                            Return (Zero)
                        }
                        Else
                        {
                            Return (0x1B)
                        }
                    }
                    ElseIf ((ToInteger (Arg2) == 0x1A))
                    {
                        Return (0x1B)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x16))
                    {
                        Return (Zero)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x26))
                    {
                        Return (0x24)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x28))
                    {
                        If ((GPRC != One))
                        {
                            Return (0x26)
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }
                    ElseIf ((ToInteger (Arg2) == 0x29))
                    {
                        Return (0x27)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x2B))
                    {
                        If ((GPRC == One))
                        {
                            Return (0x28)
                        }
                        Else
                        {
                            Return (Zero)
                        }
                    }
                    Else
                    {
                        Return (Zero)
                    }
                }
                ElseIf ((ToInteger (Arg1) == 0x02))
                {
                    If ((ToInteger (Arg2) == One))
                    {
                        ^^PCI0.LPC0.EC0.MICM = One
                        Return (Zero)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x02))
                    {
                        ^^PCI0.LPC0.EC0.MICM = Zero
                        Return (Zero)
                    }

                    If ((ToInteger (Arg2) == 0x04))
                    {
                        ^^PCI0.LPC0.EC0.SPKL = One
                        Return (Zero)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x05))
                    {
                        ^^PCI0.LPC0.EC0.SPKL = Zero
                        Return (Zero)
                    }
                    Else
                    {
                        Return (One)
                    }
                }
            }

            Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
            {
                If ((Arg0 == 0xD0))
                {
                    Return (LSKD) /* External reference */
                }
            }

