                    DL23 ()
                    SGOV (PRST, WPRP)
                }
                Else
                {
                    ADBG ("Assume WWAN DL23() is already done")
                }

                Sleep (TR2B)
                SGOV (WBRS, PBRS)
                If ((Arg0 == Zero))
                {
                    Sleep (TBTG)
                }
                ElseIf ((Arg0 == One))
