                    Return (Zero)
                }
            }

            Name (TABL, Buffer (0x80){})
            CreateField (TABL, Zero, 0x80, SEN0)
            CreateField (TABL, 0x80, 0x80, SEN1)
            CreateField (TABL, 0x0100, 0x80, SEN2)
            CreateField (TABL, 0x0180, 0x80, SEN3)
            CreateField (TABL, 0x0200, 0x80, SEN4)
            CreateField (TABL, 0x0280, 0x80, SEN5)
            CreateField (TABL, 0x0300, 0x80, SEN6)
            CreateField (TABL, 0x0380, 0x80, SEN7)
            Method (_INI, 0, NotSerialized)  // _INI: Initialize
            {
                If ((ISS7 == One))
                {
                    SEN0 = ToUUID ("54f59096-3039-42cd-b6ba-3ed08450d420") /* Unknown UUID */
                    SEN1 = ToUUID ("9b4aa91f-aebd-4cf2-9565-672e4f0586cb") /* Unknown UUID */
                }
                Else
                {
                    SEN0 = ToUUID ("9b4aa91f-aebd-4cf2-9565-672e4f0586cb") /* Unknown UUID */
                }
            }

            Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
            {
                Name (OPTS, Buffer (One)
                {
                     0x00                                             // .
                })
                CreateBitField (OPTS, Zero, FUN0)
                CreateBitField (OPTS, One, FUN1)
                CreateBitField (OPTS, 0x02, FUN2)
                CreateBitField (OPTS, 0x03, FUN3)
                CreateBitField (OPTS, 0x04, FUN4)
                If ((Arg0 == ToUUID ("32425423-3b37-4728-ad45-d293d633111a") /* Unknown UUID */))
                {
                    Switch (ToInteger (Arg2))
                    {
                        Case (Zero)
                        {
                            If ((Arg1 >= Zero))
                            {
                                FUN0 = One
                                FUN1 = One
                            }

                            Return (OPTS) /* \_SB_.ELD0._DSM.OPTS */
                        }
                        Case (One)
                        {
                            Return (TABL) /* \_SB_.ELD0.TABL */
                        }

                    }
                }
                ElseIf ((Arg0 == ToUUID ("738cebca-357e-4d97-871e-45b15c0300f3") /* Unknown UUID */))
                {
                    Switch (ToInteger (Arg2))
                    {
                        Case (Zero)
                        {
                            If ((Arg1 >= Zero))
                            {
                                FUN0 = One
                                FUN1 = One
                                FUN2 = One
                            }

                            If ((Arg1 >= One))
                            {
                                FUN3 = One
                                FUN4 = One
                            }

                            Return (OPTS) /* \_SB_.ELD0._DSM.OPTS */
                        }
                        Case (One)
                        {
                            If ((Arg1 >= Zero))
                            {
                                If (CondRefOf (\_SB.SLPB))
                                {
                                    Notify (SLPB, 0x80) // Status Change
                                    Return (One)
                                }
                            }
                        }
                        Case (0x02)
                        {
                            If ((Arg1 >= Zero))
                            {
                                If (CondRefOf (\_SB.SLPB))
                                {
                                    Notify (SLPB, 0x02) // Device Wake
                                    Return (One)
                                }
                            }
                        }
                        Case (0x03)
                        {
                            If ((Arg1 >= One))
                            {
                                If (CondRefOf (\_SB.PWRB))
                                {
                                    Notify (PWRB, 0x80) // Status Change
                                    Return (One)
                                }
                            }
                        }
                        Case (0x04)
                        {
                            If ((Arg1 >= One))
                            {
                                If (CondRefOf (\_SB.PWRB))
                                {
                                    Notify (PWRB, 0x02) // Device Wake
                                    Return (One)
                                }
                            }
                        }

                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

