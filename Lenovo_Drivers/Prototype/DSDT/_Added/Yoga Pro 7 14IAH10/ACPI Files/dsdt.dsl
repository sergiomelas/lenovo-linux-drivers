                                /* 0148 */  0x31, 0x00, 0x8C, 0x34, 0x00, 0x01, 0x01, 0x01,  // 1..4....
                                /* 0150 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                                /* 0158 */  0x17, 0x00, 0x00, 0x19, 0x00, 0x37, 0x00, 0x00,  // .....7..
                                /* 0160 */  0x00, 0x06, 0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E,  // ...\_SB.
                                /* 0168 */  0x50, 0x43, 0x30, 0x30, 0x2E, 0x58, 0x48, 0x43,  // PC00.XHC
                                /* 0170 */  0x49, 0x2E, 0x52, 0x48, 0x55, 0x42, 0x2E, 0x48,  // I.RHUB.H
                                /* 0178 */  0x53, 0x30, 0x36, 0x2E, 0x56, 0x47, 0x50, 0x31,  // S06.VGP1
                                /* 0180 */  0x00, 0x8C, 0x34, 0x00, 0x01, 0x01, 0x01, 0x00,  // ..4.....
                                /* 0188 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x17,  // ........
                                /* 0190 */  0x00, 0x00, 0x19, 0x00, 0x37, 0x00, 0x00, 0x00,  // ....7...
