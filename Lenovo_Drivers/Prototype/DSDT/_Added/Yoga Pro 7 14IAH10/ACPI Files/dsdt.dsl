                    /* 0030 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0xB0,  // ........
                    /* 0038 */  0xFF, 0xFF, 0xFF, 0xBF, 0x00, 0x00, 0x00, 0x00,  // ........
                    /* 0040 */  0x00, 0x00, 0x00, 0x10, 0x8A, 0x2B, 0x00, 0x00,  // .....+..
                    /* 0048 */  0x0C, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                    /* 0050 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x40, 0x00,  // ......@.
                    /* 0058 */  0x00, 0x00, 0xFF, 0xFF, 0xFF, 0xFF, 0x5F, 0x00,  // ......_.
                    /* 0060 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                    /* 0068 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x20, 0x00,  // ...... .
                    /* 0070 */  0x00, 0x00, 0x79, 0x00                           // ..y.
                })
                Method (_CRS, 0, Serialized)  // _CRS: Current Resource Settings
                {
                    CreateWordField (BUF0, 0x0A, PBMX)
                    CreateWordField (BUF0, 0x08, PBMN)
                    CreateWordField (BUF0, 0x0E, PBLN)
                    PBMN = PBSB /* External reference */
                    PBMX = PBSL /* \PBSL */
                    PBLN = (PBMX - PBMN) /* \_SB_.PC02._CRS.PBMN */
                    PBLN += One
                    CreateDWordField (BUF0, 0x1A, I1MN)
                    CreateDWordField (BUF0, 0x1E, I1MX)
                    CreateDWordField (BUF0, 0x26, I1LN)
                    I1MN = PIOB /* \PIOB */
                    I1MX = PIOL /* \PIOL */
                    I1LN = (I1MX - I1MN) /* \_SB_.PC02._CRS.I1MN */
                    I1LN += One
                    CreateDWordField (BUF0, 0x34, M1MN)
                    CreateDWordField (BUF0, 0x38, M1MX)
                    CreateDWordField (BUF0, 0x40, M1LN)
                    M1MN = PMEB /* \PMEB */
                    M1MX = PMEL /* \PMEL */
                    M1LN = (M1MX - M1MN) /* \_SB_.PC02._CRS.M1MN */
                    M1LN += One
                    CreateQWordField (BUF0, 0x6A, M2LN)
                    CreateQWordField (BUF0, 0x52, M2MN)
                    CreateQWordField (BUF0, 0x5A, M2MX)
                    M2MN = PPMB /* \PPMB */
                    M2MX = PPML /* \PPML */
                    M2LN = (M2MX - M2MN) /* \_SB_.PC02._CRS.M2MN */
                    M2LN += One
                    Return (BUF0) /* \_SB_.PC02.BUF0 */
                }

                Name (GUID, ToUUID ("33db4d5b-1ff7-401c-9657-7441c03dd766") /* PCI Host Bridge Device */)
                Name (SUPP, Zero)
