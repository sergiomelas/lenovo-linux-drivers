                                /* 0238 */  0x00, 0x37, 0x00, 0x00, 0x00, 0x0A, 0x00, 0x5C,  // .7.....\
                                /* 0240 */  0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43, 0x30, 0x30,  // _SB.PC00
                                /* 0248 */  0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E, 0x52, 0x48,  // .XHCI.RH
                                /* 0250 */  0x55, 0x42, 0x2E, 0x48, 0x53, 0x30, 0x36, 0x2E,  // UB.HS06.
                                /* 0258 */  0x56, 0x47, 0x50, 0x31, 0x00, 0x8C, 0x34, 0x00,  // VGP1..4.
                                /* 0260 */  0x01, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                                /* 0268 */  0x00, 0x00, 0x00, 0x17, 0x00, 0x00, 0x19, 0x00,  // ........
                                /* 0270 */  0x37, 0x00, 0x00, 0x00, 0x0B, 0x00, 0x5C, 0x5F,  // 7.....\_
