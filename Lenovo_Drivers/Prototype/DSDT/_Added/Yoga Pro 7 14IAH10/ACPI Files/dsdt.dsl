            Method (PC2M, 2, Serialized)
            {
                Local0 = GPCB ()
                Local0 += (Arg1 << 0x14)
                Local0 += ((Arg0 & 0x001F0000) >> One)
                Local0 += ((Arg0 & 0x07) << 0x0C)
                Return (Local0)
            }

