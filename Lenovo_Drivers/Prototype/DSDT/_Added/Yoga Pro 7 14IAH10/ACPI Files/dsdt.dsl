                    I1LN += One
                    M1MN = SMEB /* \SMEB */
                    M1MX = SMEL /* \SMEL */
                    M1LN = (M1MX - M1MN) /* \_SB_.PC00._CRS.M1MN */
                    M1LN += One
                    M2MN = SPMB /* \SPMB */
                    M2MX = SPML /* \SPML */
                    M2LN = (M2MX - M2MN) /* \_SB_.PC00._CRS.M2MN */
                    M2LN += One
                }

