                    CreateDWordField (Local0, 0x04, CDW2)
                    CreateDWordField (Local0, 0x08, CDW3)
                    If ((Arg0 != GUID))
                    {
                        CDW1 |= 0x04
                        Return (Local0)
                    }

                    If ((Arg1 != One))
                    {
                        CDW1 |= 0x08
                        Return (Local0)
                    }

                    SUPP = CDW2 /* \_SB_.PC02._OSC.CDW2 */
                    CTRL = CDW3 /* \_SB_.PC02._OSC.CDW3 */
                    ADBG ("PC02 Support")
                    ADBG (ToHexString (SUPP))
                    ADBG ("PC02 Control")
                    ADBG (ToHexString (CTRL))
                    If ((CDW3 != CTRL))
                    {
