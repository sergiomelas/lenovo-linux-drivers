                                    Return (One)
                                }
                                Else
                                {
                                    ADBG ("Disable DLRM for Storage")
                                    Return (Zero)
                                }
                            }

                        }
                    }
                }

                If (WIST ())
                {
                    If (EDSM (Arg0))
