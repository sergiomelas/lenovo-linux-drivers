                CreateWordField (BUF3, \_SB.IOTR._CRS._Y25._MIN, AMI3)  // _MIN: Minimum Base Address
                CreateWordField (BUF3, \_SB.IOTR._CRS._Y25._MAX, AMA3)  // _MAX: Maximum Base Address
                Local2 = Zero
