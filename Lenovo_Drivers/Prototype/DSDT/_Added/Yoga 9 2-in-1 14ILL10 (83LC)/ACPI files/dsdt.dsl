                    CreateDWordField (BUF1, \_SB.URSC.UARB._Y2E._BAS, ADR1)  // _BAS: Base Address
                    CreateDWordField (BUF2, \_SB.URSC.UARB._Y2F._BAS, ADR2)  // _BAS: Base Address
