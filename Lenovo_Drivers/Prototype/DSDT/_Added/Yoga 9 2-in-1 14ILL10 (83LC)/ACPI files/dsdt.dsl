                                I3R2 [0x09] = FMT2 /* \FMT2 */
                                I3R2 [0x0B] = FPT2 /* \FPT2 */
                                I3R2 [0x0D] = SST2 /* \SST2 */
                                I3R2 [0x0F] = ELC2 /* \ELC2 */
                                I3R2 [0x11] = ETL2 /* \ETL2 */
                                I3R2 [0x13] = SWD2 /* \SWD2 */
                                I3R2 [0x15] = BDL2 /* \BDL2 */
