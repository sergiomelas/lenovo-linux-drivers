                                DerefOf (DerefOf (DerefOf (DEVY [Local0]) [0x02]
                                    ) [One]) [One] = 0x03
                                DerefOf (DerefOf (DerefOf (DEVY [Local0]) [0x02]
                                    ) [One]) [0x02] = Zero
                                DCED ("\\_SB.PC00.CNVW", One)
                            }
                        }

                        If (CondRefOf (\_SB.PC00.BTPC))
                        {
                            If ((^^PC00.BTPC.VDID != 0xFFFFFFFF))
                            {
                                ADBG ("CNVi- BTPC PEP")
                                Local0 = PARS ("\\_SB.PC00.BTPC")
                                DerefOf (DerefOf (DerefOf (DEVY [Local0]) [0x02]
                                    ) [One]) [One] = 0x03
                                DerefOf (DerefOf (DerefOf (DEVY [Local0]) [0x02]
                                    ) [One]) [0x02] = Zero
                                DCED ("\\_SB.PC00.BTPC", One)
                            }
                        }

                        If ((GBES != Zero))
                        {
                            If (CondRefOf (\_SB.PC00.GLAN))
                            {
                                ADBG ("GLAN- PEP")
                                DCED ("\\_SB.PC00.GLAN", One)
                            }
                        }

                        Return (DEVY) /* \_SB_.PEPD.DEVY */
                    }

                    If ((Arg2 == 0x02))
                    {
                        Return (BCCD) /* \_SB_.PEPD.BCCD */
                    }

                    If ((Arg2 == 0x03))
                    {
                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, Zero)
                            SGOV (0x00181080, Zero)
                            SGOV (0x00180408, Zero)
                            If ((^^PC00.LPCB.EC0.MCSD != Zero))
                            {
                                SGOV (0x08050011, Zero)
                            }

                            SGOV (0x00180407, Zero)
                            ^^PC00.LPCB.EC0.MLED = One
                        }
                    }

                    If ((Arg2 == 0x04))
                    {
                        If ((S0ID == One))
                        {
                            D8XH (Zero, 0xC5)
                            D8XH (One, 0xAB)
                            ^^PC00.LPCB.EC0.MLED = Zero
                            If ((^^PC00.LPCB.EC0.HKDB == Zero))
                            {
                                SGOV (0x00181080, Zero)
                            }
                            Else
                            {
                                SGOV (0x00181080, One)
                            }

                            If ((^^PC00.LPCB.EC0.CAPL == Zero))
                            {
                                SGOV (0x00180408, Zero)
                            }
                            Else
                            {
                                SGOV (0x00180408, One)
                            }

                            If ((^^PC00.LPCB.EC0.MCSD != Zero))
                            {
                                If ((^^PC00.LPCB.EC0.NUML == Zero))
                                {
                                    SGOV (0x08050011, One)
                                }
                                Else
                                {
                                    SGOV (0x08050011, Zero)
                                }
                            }

                            If ((^^PC00.LPCB.EC0.MICL == One))
                            {
                                SGOV (0x00180407, One)
                            }
                            Else
                            {
                                SGOV (0x00180407, Zero)
                            }
                        }
                    }

                    If ((Arg2 == 0x05))
                    {
                        ADBG ("[PEP] deep standby entry")
                        If ((S0ID == One))
                        {
                            GUAM (One)
                        }

                        If (CondRefOf (\_SB.PC00.LPCB.NTIR))
                        {
                            ^^PC00.LPCB.NTIR (One)
                        }

                        If (CondRefOf (\_SB.PC00.TXHC))
                        {
                            If (CondRefOf (\_SB.PC00.TDM0))
                            {
                                If ((^^PC00.TDM0._STA == 0x0F))
                                {
                                    If ((^^PC00.TDM0.SCME == Zero))
                                    {
                                        ADBG ("TDM0 raise DPOF")
                                        ^^PC00.DPOF = One
                                    }
                                }
                            }
                            ElseIf (CondRefOf (\_SB.PC00.TDM1))
                            {
                                If ((^^PC00.TDM1._STA == 0x0F))
                                {
                                    If ((^^PC00.TDM1.SCME == Zero))
                                    {
                                        ADBG ("TDM1 raise DPOF")
                                        ^^PC00.DPOF = One
                                    }
                                }
                            }

                            ADBG (Concatenate ("All Monitor off flag: ", ToHexString (^^PC00.DPOF)))
                        }
                    }

                    If ((Arg2 == 0x06))
                    {
                        ADBG ("[PEP] deep standby exit")
                        If ((S0ID == One))
                        {
                            GUAM (Zero)
                        }

                        If (CondRefOf (\_SB.PC00.LPCB.NTIR))
                        {
                            ^^PC00.LPCB.NTIR (Zero)
                        }

                        If (CondRefOf (\_SB.PC00.TXHC))
                        {
                            ^^PC00.DPOF = Zero
                        }
                    }
                }

                Return (Buffer (One)
                {
                     0x00                                             // .
                })
            }
        }
    }

