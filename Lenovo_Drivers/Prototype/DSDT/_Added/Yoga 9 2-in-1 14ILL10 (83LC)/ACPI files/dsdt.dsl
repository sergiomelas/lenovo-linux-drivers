                    Name (TFST, Package (0x03)
                    {
                        Zero, 
                        Zero, 
                        Zero
                    })
                    Method (_FST, 0, NotSerialized)  // _FST: Fan Status
                    {
                        If ((FANL <= One))
                        {
                            TFST [0x02] = Zero
                        }
                        ElseIf ((FANL == 0x02))
                        {
                            TFST [0x02] = 0x09C4
                        }
                        ElseIf ((FANL == 0x03))
                        {
                            TFST [0x02] = 0x0DAC
                        }
                        ElseIf ((FANL == 0x04))
                        {
                            TFST [0x02] = 0x1194
                        }

                        If ((DerefOf (TFST [0x02]) > Zero))
                        {
                            TFST [One] = One
                        }
                        Else
                        {
                            TFST [One] = Zero
                        }

                        Return (TFST) /* \_SB_.VFAN.TFST */
