                }
            }

            Method (THMC, 0, Serialized)
            {
                If (IGDS)
                {
                    ODV0 = Zero
                }
                Else
                {
                    ODV0 = One
                }

                If ((ECRD (RefOf (CUTC)) == One))
                {
                    ODV1 = 0x04
                    If ((ECRD (RefOf (F9F9)) == Zero))
                    {
                        F9F0 = One
                        F9F1 = 0x02
                        F9F2 = 0x03
                        F9F3 = 0x04
                        F9F4 = 0x05
                        F9F5 = 0x06
                        F9F6 = 0x07
                        F9F7 = 0x08
                        F9F8 = 0x09
                        F9F9 = 0x0A
                    }
                }
                ElseIf ((ECRD (RefOf (ECWR)) & One))
                {
                    If ((ECRD (RefOf (ECWR)) & 0x80))
