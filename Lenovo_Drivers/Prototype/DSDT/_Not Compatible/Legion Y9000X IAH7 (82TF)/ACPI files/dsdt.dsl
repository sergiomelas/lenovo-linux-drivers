                            PKG1 [One] = Local0
                        }
                        Else
                        {
                            Local0 = (B1CR * B1FV)
                            Local0 = (Local0 / 0x03E8)
                            PKG1 [One] = Local0
                        }
                    }
                    ElseIf ((XX10 == One))
                    {
                        Local0 = (B1CR * 0x0A)
                        PKG1 [One] = Local0
                    }
                    Else
                    {
                        Local0 = (B1CR * B1FV)
                        Local0 = (Local0 / 0x03E8)
                        PKG1 [One] = Local0
                    }

                    If ((XX10 == One))
                    {
                        PKG1 [0x02] = (B1RC * 0x0A)
                    }
                    Else
                    {
                        Local1 = (B1RC * B1FV)
                        Local1 = (Local1 / 0x03E8)
                        PKG1 [0x02] = Local1
                    }

