                    Local0 = Zero
                    If ((ECWR & 0x04))
                    {
                        Local0 = 0x02
                    }
                    ElseIf ((ECWR & 0x08))
                    {
                        Local0 = One
                    }

                    If ((ECWR & 0x40))
                    {
                        Local0 |= 0x04
                    }

                    PKG1 [Zero] = Local0
                    If ((B1ST & One))
                    {
                        If ((XX10 == One))
                        {
