                Method (_BIX, 0, Serialized)  // _BIX: Battery Information Extended
                {
                    Name (BPK1, Package (0x15)
                    {
                        One, 
                        Zero, 
                        0xFFFFFFFF, 
                        0xFFFFFFFF, 
                        One, 
                        0xFFFFFFFF, 
                        Zero, 
                        Zero, 
                        0x64, 
                        0x00017318, 
                        Zero, 
                        Zero, 
                        Zero, 
                        Zero, 
                        0x64, 
                        Zero, 
                        "SR Real Battery", 
                        "123456789", 
                        "LiP", 
                        "LENOVO", 
                        One
                    })
                    If ((XX10 == One))
                    {
                        Local0 = (B1DC * 0x0A)
                        BPK1 [0x02] = Local0
                    }
                    Else
                    {
                        Local0 = (B1DC * B1FV)
                        Local0 = (Local0 / 0x03E8)
                        BPK1 [0x02] = Local0
                    }

                    If ((XX10 == One))
                    {
                        Local1 = (B1FC * 0x0A)
                        BPK1 [0x03] = Local1
                    }
                    Else
                    {
                        Local1 = (B1FC * B1FV)
                        Local1 = (Local1 / 0x03E8)
                        BPK1 [0x03] = Local1
                    }

                    BPK1 [0x06] = (Local1 / 0x0A)
                    BPK1 [0x07] = (Local1 / 0x19)
                    BPK1 [0x08] = BCYC /* \_SB_.PC00.LPCB.H_EC.BCYC */
                    BPK1 [0x10] = ToString (BDN1, Ones)
                    BPK1 [0x11] = ToHexString (B1SN)
                    BPK1 [0x13] = ToString (BVN1, Ones)
                    Return (BPK1) /* \_SB_.PC00.LPCB.H_EC.BAT0._BIX.BPK1 */
                }

                Method (_BST, 0, NotSerialized)  // _BST: Battery Status
                {
                    Name (PKG1, Package (0x04)
                    {
                        Ones, 
                        Ones, 
                        Ones, 
                        Ones
