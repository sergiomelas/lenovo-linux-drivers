                If ((Arg0 == 0x02))
                {
                    Local0 = ECRD (RefOf (HPFF))
                }

                If ((Arg0 == 0x03))
                {
                    Local0 = ECRD (RefOf (APPF))
                }

                Return (Local0)
            }

            Method (WEJF, 2, NotSerialized)
            {
                If ((Arg0 == One))
                {
                    ECWT (Arg1, RefOf (IGPS))
                }

                If ((Arg0 == 0x02))
                {
                    ECWT (Arg1, RefOf (HPFF))
                }

                If ((Arg0 == 0x03))
                {
                    ECWT (Arg1, RefOf (APPF))
