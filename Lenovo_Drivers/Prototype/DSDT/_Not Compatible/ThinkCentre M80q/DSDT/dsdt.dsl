    Device (WMI2)
    {
        Name (_HID, EisaId ("PNP0C14") /* Windows Management Instrumentation Device */)  // _HID: Hardware ID
        Name (_UID, "GamingWMI")  // _UID: Unique ID
        Name (_WDG, Buffer (0x3C)
        {
            /* 0000 */  0xF3, 0x54, 0x7B, 0x88, 0xDC, 0xDD, 0x2C, 0x4B,  // .T{...,K
            /* 0008 */  0x8B, 0x88, 0x68, 0xA2, 0x6A, 0x88, 0x35, 0xD0,  // ..h.j.5.
            /* 0010 */  0x47, 0x30, 0x01, 0x02, 0x35, 0xA4, 0x72, 0xBC,  // G0..5.r.
            /* 0018 */  0xC1, 0xF8, 0x75, 0x42, 0xB3, 0xE2, 0xD8, 0xB8,  // ..uB....
            /* 0020 */  0x07, 0x4A, 0xBA, 0x59, 0xA0, 0x00, 0x01, 0x08,  // .J.Y....
            /* 0028 */  0x21, 0x12, 0x90, 0x05, 0x66, 0xD5, 0xD1, 0x11,  // !...f...
            /* 0030 */  0xB2, 0xF0, 0x00, 0xA0, 0xC9, 0x06, 0x29, 0x10,  // ......).
            /* 0038 */  0x47, 0x41, 0x01, 0x00                           // GA..
        })
        Mutex (GWMI, 0x07)
        Name (LSFM, Buffer (0x04){})
        Name (LCLS, Buffer (0x04){})
        Method (WMG0, 3, NotSerialized)
        {
            Acquire (GWMI, 0xFFFF)
            If ((Arg1 == One)){}
            If ((Arg1 == 0x02)){}
            If ((Arg1 == 0x03))
            {
                LSFM = Arg2
                If ((LSFM == One)){}
                If ((LSFM == 0x02)){}
                If ((LSFM == 0x03)){}
            }

            If ((Arg1 == 0x04)){}
            If ((Arg1 == 0x05)){}
            If ((Arg1 == 0x06)){}
            If ((Arg1 == 0x07))
            {
                LCLS = Arg2
                If ((LCLS == Zero)){}
                If ((LCLS == One)){}
            }

            Release (GWMI)
            Return (Zero)
        }

        Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
        {
            If ((Arg0 == 0xA0)){}
            Return (Zero)
        }

