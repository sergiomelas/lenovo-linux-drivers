                {
                    \_SB.PCI0.RP17.NFRP ()
                }

                If (CondRefOf (\_SB.PCI0.RP21.NFRP))
                {
                    \_SB.PCI0.RP21.NFRP ()
                }
            }

            If ((UTCE && (\_SB.GGIV (0x030A0007) == Zero)))
            {
                Local0 = Zero
                While ((Local0 < 0x0A))
                {
                    If ((\_SB.GGOV (0x030A0006) == Zero))
                    {
                        Break
