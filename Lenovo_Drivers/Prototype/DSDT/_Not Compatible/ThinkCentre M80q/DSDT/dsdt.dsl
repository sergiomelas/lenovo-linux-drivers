    Method (RWAK, 1, Serialized)
    {
        D8XH (One, 0xAB)
        ADBG ("_WAK")
        If ((TBTS == One))
        {
            TRD3 = Zero
        }

        If ((DPTF == One))
        {
            \_SB.IETM.FANS ()
            \_SB.IETM.ECCR ()
        }

        If (NEXP)
        {
            If ((OSCC & One))
            {
                NHPG ()
            }

            If ((OSCC & 0x04))
            {
                NPME ()
            }
        }

        If ((Arg0 == 0x03))
        {
            If ((DPTF == One))
            {
                \_SB.IETM.FANC ()
            }

            If ((Zero == ACTT))
            {
                If ((ECON == One))
                {
                    \_SB.PCI0.LPCB.H_EC.ECWT (Zero, RefOf (\_SB.PCI0.LPCB.H_EC.CFAN))
                }
            }
        }

