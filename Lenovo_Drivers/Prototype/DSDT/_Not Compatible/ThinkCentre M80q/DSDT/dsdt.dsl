                }
            }
        }

        If (((Arg0 == 0x03) || (Arg0 == 0x04)))
        {
            If (CondRefOf (\_SB.PCI0.PEG0.PEGP.INIO))
            {
                \_SB.PCI0.PEG0.PEGP.INIO (Arg0)
            }
        }

        If ((TBTS == One))
        {
            Signal (WFEV)
        }

        If ((Arg0 == 0x04))
        {
            If ((CondRefOf (\_SB.AWAC) && CondRefOf (TADW)))
            {
                ADBG ("TADW")
                ADBG (TADW)
                If ((TADW == One))
                {
                    \_SB.AWAC.WAST = One
                    Notify (\_SB.AWAC, 0x02) // Device Wake
                    ADBG ("Notify AWAC of Alarm Device Wake")
