            }

            If ((\_SB.PCI0.RP20.VDID != 0xFFFFFFFF))
            {
                Notify (\_SB.PCI0.RP20, Zero) // Bus Check
            }

            If ((TBTS == One))
            {
                If (CondRefOf (\_SB.PCI0.RP01.NFRP))
                {
                    \_SB.PCI0.RP01.NFRP ()
                }

                If (CondRefOf (\_SB.PCI0.RP05.NFRP))
                {
                    \_SB.PCI0.RP05.NFRP ()
                }

                If (CondRefOf (\_SB.PCI0.RP09.NFRP))
                {
                    \_SB.PCI0.RP09.NFRP ()
                }

