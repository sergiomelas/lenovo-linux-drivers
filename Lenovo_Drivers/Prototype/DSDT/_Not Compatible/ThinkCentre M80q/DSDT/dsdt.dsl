            }

            If (CondRefOf (TADW))
            {
                TADW = Zero
            }
        }

        If ((\_SB.ITBM == One))
        {
            If ((((\_SB.ITBP != Zero) && (\_SB.OSCP & 0x1000)) && (
                \_SB.OCLK == Zero)))
            {
                SSMP = \_SB.ITBS /* External reference */
            }
        }

        Notify (\_SB.PCI0.XHC, 0x02) // Device Wake
        Return (Package (0x02)
        {
            Zero, 
            Zero
        })
    }

