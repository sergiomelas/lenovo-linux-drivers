    If (((WLGP != Zero) && (WLRP == 0x04)))
    {
        Scope (_SB.PCI0.RP04)
        {
            Method (PPRW, 0, NotSerialized)
            {
                Return (GPRW (GGPE (WLGP), 0x04))
            }
        }
