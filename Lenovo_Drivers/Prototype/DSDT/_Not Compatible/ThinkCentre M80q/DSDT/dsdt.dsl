            Name (INTR, Buffer (0x0B)
            {
                /* 0000 */  0x89, 0x06, 0x00, 0x15, 0x01, 0x00, 0x00, 0x00,  // ........
                /* 0008 */  0x00, 0x79, 0x00                                 // .y.
            })
            CreateDWordField (INTR, 0x05, NUMI)
            NUMI = INUM (Arg0)
            CreateBitField (INTR, 0x19, LEVI)
            LEVI = Arg1
            CreateBitField (INTR, 0x1A, ACTI)
            ACTI = Arg2
