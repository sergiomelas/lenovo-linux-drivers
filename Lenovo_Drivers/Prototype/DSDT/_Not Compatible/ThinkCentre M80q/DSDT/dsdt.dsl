                CreateDWordField (RBUF, 0x10, COM1)
                CreateDWordField (RBUF, 0x29, IRQN)
                COM0 = (SBRG + 0x006E0000)
                COM1 = (SBRG + 0x006D0000)
                IRQN = SGIR /* \SGIR */
                If ((PCHS == PCHH))
                {
