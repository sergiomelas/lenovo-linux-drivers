                    CMH3 = (SBRG + 0x006B0000)
                    CreateDWordField (CBUF, 0x04, CMH4)
                    CMH4 = (SBRG + 0x006A0000)
                    Return (ConcatenateResTemplate (RBUF, CBUF))
