        Device (TPD0)
        {
            Name (HID2, Zero)
            Name (SBFB, Buffer (0x19)
            {
                /* 0000 */  0x8E, 0x14, 0x00, 0x01, 0x00, 0x01, 0x02, 0x00,  // ........
                /* 0008 */  0x00, 0x01, 0x06, 0x00, 0x80, 0x1A, 0x06, 0x00,  // ........
