                    If ((Arg2 == Zero))
                    {
                        Return (Buffer (0x04)
                        {
                             0x02, 0x35, 0x02, 0x34                           // .5.4
                        })
                    }

                    If ((Arg2 == One))
                    {
                        Return (Buffer (One)
                        {
                             0x02                                             // .
                        })
                    }

                    If ((Arg2 == 0x03))
                    {
                        Return (Buffer (One)
                        {
