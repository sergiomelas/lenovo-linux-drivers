                    /* 0008 */  0x00, 0x01, 0x06, 0x00, 0x80, 0x1A, 0x06, 0x00,  // ........
                    /* 0010 */  0x35, 0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x49,  // 5.\_SB.I
                    /* 0018 */  0x32, 0x43, 0x42, 0x00, 0x8E, 0x19, 0x00, 0x02,  // 2CB.....
                    /* 0020 */  0x00, 0x01, 0x02, 0x00, 0x00, 0x01, 0x06, 0x00,  // ........
                    /* 0028 */  0x80, 0x1A, 0x06, 0x00, 0x34, 0x00, 0x5C, 0x5F,  // ....4.\_
                    /* 0030 */  0x53, 0x42, 0x2E, 0x49, 0x32, 0x43, 0x42, 0x00,  // SB.I2CB.
                    /* 0038 */  0x8C, 0x20, 0x00, 0x01, 0x01, 0x01, 0x00, 0x01,  // . ......
                    /* 0040 */  0x00, 0x03, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                    /* 0048 */  0x00, 0x19, 0x00, 0x23, 0x00, 0x00, 0x00, 0x1D,  // ...#....
                    /* 0050 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x47, 0x50,  // .\_SB.GP
                    /* 0058 */  0x49, 0x4F, 0x00, 0x8C, 0x20, 0x00, 0x01, 0x00,  // IO.. ...
                    /* 0060 */  0x01, 0x00, 0x1B, 0x00, 0x03, 0x00, 0x00, 0x00,  // ........
                    /* 0068 */  0x00, 0x17, 0x00, 0x00, 0x19, 0x00, 0x23, 0x00,  // ......#.
                    /* 0070 */  0x00, 0x00, 0x0B, 0x00, 0x5C, 0x5F, 0x53, 0x42,  // ....\_SB
